<Window x:Class="MeetingAssistant.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Assistant"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <TextBlock
                FontSize="32"
                FontWeight="Bold"
                Text="Meeting Assistant"/>

            <TextBlock
                Margin="0,20,0,20"
                FontSize="18"
                Text="{Binding Status}"/>

            <Button Content="Start Meeting"
        Command="{Binding StartMeetingCommand}"
        Width="150"
        Margin="0,10,0,0"/>

            <Button Content="Stop Meeting"
        Command="{Binding StopMeetingCommand}"
        Width="150"
        Margin="0,10,0,0"/>

            <TextBlock Text="{Binding Status}"
           Margin="0,20,0,0"
           FontWeight="Bold"/>

        </StackPanel>

    </Grid>

</Window>